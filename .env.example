# Copy to .env and fill in. NEVER commit .env.
# Phase 1: the AI brain. Default is Gemini (free tier). Set LLM_PROVIDER=anthropic to use Claude instead.
LLM_PROVIDER=gemini

# Gemini (free). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Our own speed limits so we stay inside the free tier. Check yours at https://aistudio.google.com/rate-limit
# GEMINI_RPM = requests per minute. GEMINI_RPD = requests per day (0 = no local cap, rely on Google's 429).
GEMINI_RPM=5
# For live voice chat use GEMINI_RPM=15 or more: the slow-down waits 60/RPM seconds between calls, so 5 means 12 s of waiting per AI call.
# Speech calls per minute we allow ourselves. Batch tests keep these low; a live voice chat needs them higher:
# SPEECH_RPM=20 (Gemini speech)   SARVAM_RPM=60 (Sarvam)
GEMINI_RPD=0

# Speech (Phase 3). Default speech provider is Gemini.
# STT_PROVIDER=gemini | gemini_prompt | sarvam      TTS_PROVIDER=gemini | sarvam
# DEVELOPMENT RULE: use Gemini's free voice while building (TTS_PROVIDER=gemini, TTS_FALLBACK=none). Use Sarvam's voice (TTS_PROVIDER=sarvam)
# only for final tests, the voice-choice step and the demo. Speech-to-text stays on Sarvam. Run scripts/sarvam_credits.py after each test session.
# (leave these unset to use the defaults; the bake-off sets them per run)
# STT_PROVIDER=gemini_prompt
# TTS_PROVIDER=gemini
# Sarvam AI (optional second speech provider, Indian-language specialist). Key from https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Sarvam gives Rs 100 free credit. We keep our own estimate of what is left and fall back to Gemini when it runs out.
SARVAM_CREDIT_RUPEES=100
SARVAM_CREDIT_ALREADY_SPENT=29.7
# Defaults: Sarvam first, Gemini as the backup (set STT_FALLBACK=none to turn the backup off)
# STT_PROVIDER=sarvam   STT_FALLBACK=gemini_prompt   TTS_PROVIDER=sarvam   TTS_FALLBACK=gemini
SARVAM_STT_MODEL=saaras:v4
# Give Sarvam v4 our company names so it spells them right (true/false)
SARVAM_COMPANY_KEYTERMS=true
# How Hindi-English speech is written: codemix (Hindi words in Hindi script, English words in English; best for numbers), translit, transcribe
SARVAM_HINGLISH_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v4-flash

# Claude (optional, paid)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium

# Phase 2
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Phase 3 (speech provider, e.g. Sarvam)
SPEECH_PROVIDER_API_KEY=
# Phase 4 (phone provider)
PHONE_PROVIDER_ACCOUNT_ID=
PHONE_PROVIDER_API_KEY=
PHONE_PROVIDER_API_TOKEN=
PHONE_PROVIDER_FROM_NUMBER=
# Phase 7 (encryption key for private user details)
DATA_ENCRYPTION_KEY=
# Phase 8 (email)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Faster live-voice brain (free tier, no card): https://console.groq.com . Set LLM_PROVIDER=groq to use it, Gemini is the automatic backup.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM=25

# Voice picks per language (founder, 2026-10-23); the other provider is the automatic backup
TTS_BY_LANGUAGE=en-IN:gemini,hi-IN:sarvam,ta-IN:sarvam,hinglish:sarvam
