# Copy to .env and fill in. NEVER commit .env.
# Phase 1
ANTHROPIC_API_KEY=
# Model name lives here, not in code. Change it to switch models.
CLAUDE_MODEL=claude-sonnet-5-5
# Optional thinking depth: low | medium | high | xhigh | max (leave empty to use the model default)
CLAUDE_EFFORT=medium
# Phase 2
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Phase 3 (speech provider, e.g. Sarvam)
SPEECH_PROVIDER_API_KEY=
# Phase 4 (phone provider)
PHONE_PROVIDER_ACCOUNT_ID=
PHONE_PROVIDER_API_KEY=
PHONE_PROVIDER_API_TOKEN=
PHONE_PROVIDER_FROM_NUMBER=
# Phase 7 (encryption key for private user details)
DATA_ENCRYPTION_KEY=
# Phase 8 (email)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
