# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# The free tests (cd backend && python -m pytest) need NO keys at all.

# ===================== QUICK START: everything below is free =====================
# The brain. groq = fast free tier (key: https://console.groq.com/keys), Gemini is the automatic backup (free key: https://aistudio.google.com/apikey).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=15

# Hearing (speech to text):
#   groq   free, fast, good for English        local  free, runs on your laptop (needs requirements-local-models.txt), Hindi/Hinglish/English, slow
#   sarvam best for Indian languages (free credit, then paid)
STT_PROVIDER=groq
STT_FALLBACK=none

# Voice (text to speech):  mac = free Mac voices (macOS only, robotic, for development)   gemini = free, sometimes slow   sarvam = best quality
TTS_PROVIDER=mac

# ===================== OPTIONAL =====================
# Sarvam AI (Indian-language speech). Key: https://dashboard.sarvam.ai . We keep our own estimate of the free credit left (.sarvam_credits.json)
# and pause Sarvam below Rs 15 until you set SARVAM_ALLOW_LOW_CREDIT=yes.
SARVAM_API_KEY=
SARVAM_CREDIT_RUPEES=100
SARVAM_CREDIT_ALREADY_SPENT=0
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_HINGLISH_MODE=codemix
SARVAM_COMPANY_KEYTERMS=true
# Per-language voice picks (provider per language); the other provider is the automatic backup:
# TTS_BY_LANGUAGE=en-IN:gemini,hi-IN:sarvam,ta-IN:sarvam,hinglish:sarvam
# SARVAM_ALLOW_LOW_CREDIT=yes

# Claude (optional, paid): LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Real phone calls (Phase 4, Twilio free trial). Only numbers listed in PHONE_ALLOWED_NUMBERS can ever be called.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PHONE_ALLOWED_NUMBERS=
PUBLIC_BASE_URL=

# Later phases (not used yet)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
